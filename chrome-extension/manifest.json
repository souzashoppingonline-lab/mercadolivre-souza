{
  "manifest_version": 3,
  "name": "FinanceEcom Monitor",
  "version": "1.0.0",
  "description": "Monitore anúncios do Mercado Livre em tempo real",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://produto.mercadolivre.com.br/*",
    "https://www.mercadolivre.com.br/*",
    "https://multimixvendas.duckdns.org/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FinanceEcom Monitor"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://produto.mercadolivre.com.br/*",
        "https://www.mercadolivre.com.br/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
