PORT=3000

# PostgreSQL — source of truth
DATABASE_URL=postgres://ml_user:ml_pass@localhost:5432/ml_dashboard

# Redis — cache + BullMQ
REDIS_URL=redis://localhost:6379

# Mercado Livre App credentials (used only by workers, never by frontend)
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=

# Secret used to validate incoming webhook requests, if applicable
ML_WEBHOOK_SECRET=

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Amazon SP-API (server/src/marketplaces/amazon/amazonClient.js) — ainda não
# conectado a nenhuma rota/worker. AMAZON_APP_ID (Application ID do Developer
# Console) NÃO é o mesmo valor que AMAZON_LWA_CLIENT_ID (Client ID da Login
# with Amazon, necessário para trocar o refresh token por access token).
AMAZON_APP_ID=
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=
AMAZON_MARKETPLACE_ID=
AMAZON_REGION=na
# sandbox | production | mock — "mock" gera pedidos de teste fabricados
# localmente (não chama a Amazon), útil para testar dashboard/KPIs sem
# depender do sandbox estático da Amazon, que só devolve um pedido fixo.
# Use "sandbox" até o app FinanceEcom ter acesso de produção aprovado no
# Seller Central (hoje o app está com Status=Sandbox).
AMAZON_ENV=sandbox

# Notion — integração para criação automática de tarefas de anúncios
# NOTION_TOKEN: Integration token de uma integração interna do Notion
#   (notion.so/my-integrations → New integration → Internal → copie o "Internal Integration Token")
# NOTION_DATABASE_ID: ID do database "Minhas Tarefas" (52d0f0fd-3410-4c1f-9b39-61da59123a6c)
#   Certifique-se de adicionar a integração ao database via "Connections" na página do Notion
NOTION_TOKEN=
NOTION_DATABASE_ID=52d0f0fd-3410-4c1f-9b39-61da59123a6c
