PORT=3000

# PostgreSQL — source of truth
DATABASE_URL=postgres://ml_user:ml_pass@localhost:5432/ml_dashboard

# Redis — cache + BullMQ
REDIS_URL=redis://localhost:6379

# Mercado Livre App credentials (used only by workers, never by frontend)
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=

# Secret used to validate incoming webhook requests, if applicable
ML_WEBHOOK_SECRET=

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Amazon SP-API (server/src/marketplaces/amazon/amazonClient.js) — ainda não
# conectado a nenhuma rota/worker. AMAZON_APP_ID (Application ID do Developer
# Console) NÃO é o mesmo valor que AMAZON_LWA_CLIENT_ID (Client ID da Login
# with Amazon, necessário para trocar o refresh token por access token).
AMAZON_APP_ID=
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=
AMAZON_MARKETPLACE_ID=
AMAZON_REGION=na
# sandbox | production | mock — "mock" gera pedidos de teste fabricados
# localmente (não chama a Amazon), útil para testar dashboard/KPIs sem
# depender do sandbox estático da Amazon, que só devolve um pedido fixo.
# Use "sandbox" até o app FinanceEcom ter acesso de produção aprovado no
# Seller Central (hoje o app está com Status=Sandbox).
AMAZON_ENV=sandbox

# Shopee Open Platform v2 (server/src/marketplaces/shopee/shopeeClient.js) —
# SHOPEE_PARTNER_ID/SHOPEE_PARTNER_KEY identificam o app (não a loja — a mesma
# credencial vale para todas as contas Shopee autorizadas). Nunca cole esses
# valores em chat/log — só aqui, no .env do servidor.
# SHOPEE_REDIRECT_URI: URL de callback OAuth cadastrada no console da Shopee
#   (ex: https://multimixvendas.duckdns.org/auth/shopee/callback)
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_REDIRECT_URI=
# sandbox (partner.uat.shopeemobile.com) | production (partner.shopeemobile.com)
# Trocar para "production" quando o app estiver aprovado ao vivo e usar as
# credenciais "ao vivo" (partner_id/partner_key da API Live) — ver .claude/shopee.md.
SHOPEE_ENV=sandbox
# "true" só se o app tiver "Acesso a dados sensíveis" aprovado no console.
# Habilita pedir buyer_username/endereço no get_order_detail. Se o app estiver
# como "Sem acesso" (padrão), deixe false — senão a chamada quebra em produção.
SHOPEE_SENSITIVE_ACCESS=false

# Notion — integração para criação automática de tarefas de anúncios
# NOTION_TOKEN: Integration token de uma integração interna do Notion
#   (notion.so/my-integrations → New integration → Internal → copie o "Internal Integration Token")
# NOTION_DATABASE_ID: ID do database "Minhas Tarefas" (52d0f0fd-3410-4c1f-9b39-61da59123a6c)
#   Certifique-se de adicionar a integração ao database via "Connections" na página do Notion
NOTION_TOKEN=
NOTION_DATABASE_ID=52d0f0fd-3410-4c1f-9b39-61da59123a6c

# Resend — envio de e-mails de relatório (resumo diário, top vendas, semanal)
# RESEND_API_KEY: chave da API (resend.com/api-keys) — free tier: 3.000 e-mails/mês, 100/dia
# RESEND_FROM_EMAIL: remetente. Sem domínio verificado no Resend, use o
#   endereço de teste padrão abaixo (funciona sem configuração extra).
# RESEND_TO_EMAIL: destinatário dos relatórios
RESEND_API_KEY=
RESEND_FROM_EMAIL=ML Dashboard <onboarding@resend.dev>
RESEND_TO_EMAIL=

# Login de acesso restrito (staff) — ver .claude/auth-staff.md.
# STAFF_AUTH_ENABLED: fica "false" (gate desligado, sistema aberto como
#   sempre foi) até você criar o 1º usuário admin (server/scripts/createStaffUser.js)
#   e mudar pra "true" + reiniciar. É o botão de emergência: voltar pra
#   "false" + restart desliga a autenticação inteira na hora, sem precisar
#   reverter nenhum deploy.
STAFF_AUTH_ENABLED=false
# Gere um valor aleatório forte (ex: openssl rand -hex 32) — nunca reaproveite
# um segredo de outro sistema.
STAFF_JWT_SECRET=
# Duração da sessão em dias (padrão 180 — evita ter que logar toda hora)
STAFF_SESSION_DAYS=180
# Webhook Shopee ("Mecanismo de Empurra"): valida a assinatura HMAC do push.
# Deixe true em produção; "false" só pro 1º teste enquanto confirma a assinatura.
SHOPEE_WEBHOOK_VERIFY=true
# "Chave de parceiro Live Push" (console Shopee → Mecanismo de Empurra) — assina
# os pushes do webhook. NÃO é a SHOPEE_PARTNER_KEY. Sem ela, verified=false.
SHOPEE_PUSH_PARTNER_KEY=
